{
  "name": "arcom-outreach-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard for the Arcom Technologies n8n lead generation / outreach system",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
