# Copy to ".env" on the VPS (next to docker-compose.prod.yml) and fill in.
# DATABASE_URL is set by docker-compose.prod.yml (SQLite in a volume) — leave it out here.

# Must EXACTLY match the N8N_DASHBOARD_SECRET you set in n8n.
N8N_DASHBOARD_SECRET="change-me-to-a-long-random-string"

# Public URL where YOU open the dashboard in a browser (display only).
# e.g. http://72.61.81.227:3001  or  https://dash.yourdomain.com
NEXT_PUBLIC_APP_URL="http://72.61.81.227:3001"

# ---- Login (required to password-protect the dashboard) ----
# If these three are set, every page requires sign-in. If left unset, the
# dashboard stays open (no login). n8n ingestion (/api/n8n/*) is never blocked
# by login — it uses N8N_DASHBOARD_SECRET instead.
AUTH_USER="you@example.com"
AUTH_PASSWORD="choose-a-strong-password"
# Long random string used to sign the session cookie (NOT shown to anyone).
AUTH_SESSION_SECRET="another-long-random-string"
