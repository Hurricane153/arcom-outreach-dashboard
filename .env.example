# ----------------------------------------------------------------------------
# Arcom Outreach Dashboard - environment variables
# Copy this file to ".env" and fill in real values.
# ----------------------------------------------------------------------------

# SQLite database file (no server, no Docker). Path is relative to /prisma.
# This default works as-is — nothing to install.
DATABASE_URL="file:./dev.db"

# Shared secret that every n8n -> dashboard request must send in the
# "X-N8N-Secret" header. Generate a long random string and use the SAME value
# in n8n (see the n8n env var N8N_DASHBOARD_SECRET below).
N8N_DASHBOARD_SECRET="change-me-to-a-long-random-string"

# Public base URL of this dashboard (used only for display in /settings).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional login. Set all three to require sign-in; leave unset for no login.
# /api/n8n/* ingestion is never blocked by this (it uses N8N_DASHBOARD_SECRET).
AUTH_USER=""
AUTH_PASSWORD=""
AUTH_SESSION_SECRET=""

# Lets the dashboard Control page start the outreach workflow.
# Your n8n base URL + /webhook/arcom-dashboard-run
N8N_RUN_WEBHOOK_URL=""

# ----------------------------------------------------------------------------
# For reference - these are set inside n8n (NOT in this dashboard .env),
# under Settings -> Variables (or as process env on the n8n host):
#
#   DASHBOARD_API_URL     = http://localhost:3000      (base URL of this app)
#   N8N_DASHBOARD_SECRET  = <same value as above>
# ----------------------------------------------------------------------------
